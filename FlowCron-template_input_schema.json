{
    "required": [
        "input"
    ],
    "properties": {
        "input": {
            "type": "object",
            "required": [
                "source",
                "dest",
				"script",
				"wait_seconds",
				"echo"
            ],
            "properties": {
                "source": {
                    "type": "object",
                    "title": "Data collection and path",
                    "description": "Select collection and path to directory containing .eer and .mdoc data files together with a .gain file.",
                    "format": "globus-collection",
                    "required": [
                        "id",
                        "path"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uuid",
							"default": "1796e092-4888-4061-8edd-f8f682388808"
                        },
                        "path": {
                            "type": "string",
							"default": "/groups/structbio/Damage-SXT/"
                        }
                    },
                    "additionalProperties": false
                },
				"dest": {
                    "type": "object",
                    "title": "HPC collection and Flowcron path",
                    "description": "Select collection and path to Flowcron directory containing the UploadedFiles subdirectory. A unit of work will be created inside UploadedFiles for the STA pipeline job. Please ensure path ends with a /",
                    "format": "globus-collection",
                    "required": [
                        "id",
                        "path"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uuid",
							"default": "a95af0f3-a49d-407f-aee8-d4b32bab380a"
                        },
                        "path": {
                            "type": "string",
							"default": "/bask/projects/h/hjcl4613-rfi-corrimg/piper/sta/flowcron/"
                        }
                    },
                    "additionalProperties": false
				},
				"script": {
                    "type": "object",
                    "title": "Submission script collection and path",
                    "description": "Select collection and path to SLURM submission script for the pipeline. This will be copied to the unit of work's scripts subdirectory.",
                    "format": "globus-collection",
                    "required": [
                        "id",
                        "path"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uuid",
							"default": "a95af0f3-a49d-407f-aee8-d4b32bab380a"
                        },
                        "path": {
                            "type": "string",
							"default": "/bask/projects/h/hjcl4613-rfi-corrimg/piper/sta/pipeline.slurm"
                        }
                    },
                    "additionalProperties": false
				},
				"echo": {
                    "type": "object",
                    "title": "Echo collection and path for analysed data",
                    "description": "Select collection and path the unit of work should be transferred to after the analysis has completed. Note directories called 'data' or 'frames' will be excluded from the transfer. Please ensure path ends with a /",
                    "format": "globus-collection",
                    "required": [
                        "id",
                        "path"
                    ],
                    "properties": {
                        "id": {
                            "type": "string",
                            "format": "uuid",
							"default": "b85f707d-83f0-4251-b11b-9c7f6045b933"
                        },
                        "path": {
                            "type": "string",
							"default": "/"
                        }
                    },
                    "additionalProperties": false
				},
				"wait_seconds": {
						"type": "integer",
						"title": "Seconds to wait between job completion checks (default 1 hour)",
						"description": "After a unit of work has been created on the HPC, Globus will check in the Flowcron AnalysedFiles directory periodically. Once the job completes (signalled by the removal of the Sentinels subdirectory), a transfer will start of the processed data.",
						"minimum": 300,
						"maximum": 86400,
						"default": 3600
				},
                "delete": {
                    "type": "boolean",
                    "title": "Delete job directory after transferring the results?",
                    "description": "Whether or not to delete the unit of work on the HPC collection once the job is completed and the processed data has been archived.",
                    "default": true
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
