{
    "Comment": "Transfer data files for a STA pipeline job (Flowcron)",
    "StartAt": "GetSourceCollection",
    "States": {
        "GetSourceCollection": {
            "Comment": "Get information about the source Collection",
            "Next": "CheckSourceCollectionId",
            "Type": "Action",
            "WaitTime": 300,
            "ActionUrl": "https://transfer.actions.globus.org/collection_info",
            "Parameters": {
                "endpoint_id.$": "$.input.source.id"
            },
            "ResultPath": "$.SourceEpInfo"
        },
        "CheckSourceCollectionId": {
            "Comment": "Check that the source collection is managed",
            "Type": "Choice",
            "Choices": [
                {
                    "Or": [
                        {
                            "And": [
                                {
                                    "Variable": "$.SourceEpInfo.details.subscription_id",
                                    "IsPresent": true
                                },
                                {
                                    "IsNull": false,
                                    "Variable": "$.SourceEpInfo.details.subscription_id"
                                }
                            ]
                        },
                        {
                            "And": [
                                {
                                    "Variable": "$.SourceEpInfo.details.entity_type",
                                    "IsPresent": true
                                },
                                {
                                    "Variable": "$.SourceEpInfo.details.entity_type",
                                    "StringEquals": "GCP_guest_collection"
                                }
                            ]
                        }
                    ],
                    "Next": "LookupSourcePath"
                }
            ]
        },
        "LookupSourcePath": {
            "Comment": "Lookup the source path to determine it is a directory",
            "Next": "CheckSourcePathInfo",
            "Type": "Action",
            "Catch": [
                {
                    "Next": "SourcePathMissing",
                    "ResultPath": "$.SourcePathLookupErrorResult",
                    "ErrorEquals": [
                        "ActionUnableToRun",
                        "ActionFailedException",
                        "ActionTimeout"
                    ]
                }
            ],
            "WaitTime": 300,
            "ActionUrl": "https://transfer.actions.globus.org/stat",
            "Parameters": {
                "path.$": "$.input.source.path",
                "endpoint_id.$": "$.input.source.id"
            },
            "ResultPath": "$.SourcePathInfo"
        },
        "SourcePathMissing": {
            "Next": "SourcePathMissingFail",
            "Type": "ExpressionEval",
            "Parameters": {
                "error.=": "'Unable to access path ' + input.source.path + ' in collection ' + input.source.id"
            },
            "ResultPath": "$.FlowResult"
        },
        "SourcePathMissingFail": {
            "Comment": "Report the error and end the flow",
            "Type": "Fail",
            "Cause": "SourcePathMissing",
            "Error": "See state in $.FlowResult of the run output"
        },
        "CheckSourcePathInfo": {
            "Comment": "Determine the type of the source path",
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.SourcePathInfo.details.code",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.SourcePathInfo.details.code",
                            "StringEquals": "NotFound"
                        }
                    ],
                    "Next": "SourcePathMissing"
                }
            ],
            "Default": "CheckIfInputPathIsDirectory"
        },
        "CheckIfInputPathIsDirectory": {
            "Comment": "Determine if the source path is a directory",
            "Type": "Choice",
            "Choices": [
                {
                    "Next": "GetDestCollection",
                    "Variable": "$.SourcePathInfo.details.type",
                    "StringEquals": "dir"
                }
            ],
            "Default": "SourcePathNotADirectory"
        },
        "SourcePathNotADirectory": {
            "Next": "SourcePathNotADirectoryFail",
            "Type": "ExpressionEval",
            "Parameters": {
                "error.=": "'Source path ' + input.source.path + ' is not a directory, and it should be a job directory.'"
            },
            "ResultPath": "$.FlowResult"
        },
        "SourcePathNotADirectoryFail": {
            "Comment": "Report the error and end the flow execution",
            "Type": "Fail",
            "Cause": "SourcePathNotADirectory",
            "Error": "See state in $.FlowResult of the run output"
        },
        "GetDestCollection": {
            "Comment": "Get information about the dest Collection",
            "Next": "CheckDestCollectionId",
            "Type": "Action",
            "WaitTime": 300,
            "ActionUrl": "https://transfer.actions.globus.org/collection_info",
            "Parameters": {
                "endpoint_id.$": "$.input.dest.id"
            },
            "ResultPath": "$.DestEpInfo"
        },
        "CheckDestCollectionId": {
            "Comment": "Check that the dest collection is managed",
            "Type": "Choice",
            "Choices": [
                {
                    "Or": [
                        {
                            "And": [
                                {
                                    "Variable": "$.DestEpInfo.details.subscription_id",
                                    "IsPresent": true
                                },
                                {
                                    "IsNull": false,
                                    "Variable": "$.DestEpInfo.details.subscription_id"
                                }
                            ]
                        },
                        {
                            "And": [
                                {
                                    "Variable": "$.DestEpInfo.details.entity_type",
                                    "IsPresent": true
                                },
                                {
                                    "Variable": "$.DestEpInfo.details.entity_type",
                                    "StringEquals": "GCP_guest_collection"
                                }
                            ]
                        }
                    ],
                    "Next": "LookupDestPath"
                }
            ]
        },
        "LookupDestPath": {
            "Comment": "Lookup the dest path to determine it is a directory",
            "Next": "CheckDestPathInfo",
            "Type": "Action",
            "WaitTime": 300,
            "Catch": [
                {
                    "Next": "DestPathMissing",
                    "ResultPath": "$.DestPathLookupErrorResult",
                    "ErrorEquals": [
                        "ActionUnableToRun",
                        "ActionFailedException",
                        "ActionTimeout"
                    ]
                }
            ],
            "ActionUrl": "https://transfer.actions.globus.org/stat",
            "Parameters": {
                "path.$": "$.input.dest.path",
                "endpoint_id.$": "$.input.dest.id"
            },
            "ResultPath": "$.DestPathInfo"
        },
        "DestPathMissing": {
            "Next": "DestPathMissingFail",
            "Type": "ExpressionEval",
            "Parameters": {
                "error.=": "'Unable to access path ' + input.dest.path + ' in collection ' + input.dest.id"
            },
            "ResultPath": "$.FlowResult"
        },
        "DestPathMissingFail": {
            "Comment": "Report the error and end the flow",
            "Type": "Fail",
            "Cause": "DestPathMissing",
            "Error": "See state in $.FlowResult of the run output"
        },
        "CheckDestPathInfo": {
            "Comment": "Determine the type of the dest path",
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.DestPathInfo.details.code",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.DestPathInfo.details.code",
                            "StringEquals": "NotFound"
                        }
                    ],
                    "Next": "DestPathMissing"
                }
            ],
            "Default": "CheckIfOutputPathIsDirectory"
        },
        "CheckIfOutputPathIsDirectory": {
            "Comment": "Determine if the dest path is a directory",
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.DestPathInfo.details.type",
                    "StringEquals": "dir",
                    "Next": "GetScriptCollection"
                }
            ],
            "Default": "DestPathNotADirectory"
        },
        "DestPathNotADirectory": {
            "Next": "DestPathNotADirectoryFail",
            "Type": "ExpressionEval",
            "Parameters": {
                "error.=": "'Dest path ' + input.dest.path + ' is not a directory, and it should be a job directory.'"
            },
            "ResultPath": "$.FlowResult"
        },
        "DestPathNotADirectoryFail": {
            "Comment": "Report the error and end the flow",
            "Type": "Fail",
            "Cause": "DestPathNotADirectory",
            "Error": "See state in $.FlowResult of the run output"
        },
        "GetScriptCollection": {
            "Comment": "Get information about the script Collection",
            "Next": "CheckScriptCollectionId",
            "Type": "Action",
            "WaitTime": 300,
            "ActionUrl": "https://transfer.actions.globus.org/collection_info",
            "Parameters": {
                "endpoint_id.$": "$.input.script.id"
            },
            "ResultPath": "$.ScriptEpInfo"
        },
        "CheckScriptCollectionId": {
            "Comment": "Check that the script collection is managed",
            "Type": "Choice",
            "Choices": [
                {
                    "Or": [
                        {
                            "And": [
                                {
                                    "Variable": "$.ScriptEpInfo.details.subscription_id",
                                    "IsPresent": true
                                },
                                {
                                    "IsNull": false,
                                    "Variable": "$.ScriptEpInfo.details.subscription_id"
                                }
                            ]
                        },
                        {
                            "And": [
                                {
                                    "Variable": "$.ScriptEpInfo.details.entity_type",
                                    "IsPresent": true
                                },
                                {
                                    "Variable": "$.ScriptEpInfo.details.entity_type",
                                    "StringEquals": "GCP_guest_collection"
                                }
                            ]
                        }
                    ],
                    "Next": "LookupScriptPath"
                }
            ]
        },
        "LookupScriptPath": {
            "Comment": "Lookup the script path to determine it is a file",
            "Next": "CheckScriptPathInfo",
            "Type": "Action",
            "Catch": [
                {
                    "Next": "ScriptPathMissing",
                    "ResultPath": "$.ScriptPathLookupErrorResult",
                    "ErrorEquals": [
                        "ActionUnableToRun",
                        "ActionFailedException",
                        "ActionTimeout"
                    ]
                }
            ],
            "WaitTime": 300,
            "ActionUrl": "https://transfer.actions.globus.org/stat",
            "Parameters": {
                "path.$": "$.input.script.path",
                "endpoint_id.$": "$.input.script.id"
            },
            "ResultPath": "$.ScriptPathInfo"
        },
        "ScriptPathMissing": {
            "Next": "ScriptPathMissingFail",
            "Type": "ExpressionEval",
            "Parameters": {
                "error.=": "'Unable to access path ' + input.script.path + ' in collection ' + input.script.id"
            },
            "ResultPath": "$.FlowResult"
        },
        "ScriptPathMissingFail": {
            "Comment": "Report the error and end the flow",
            "Type": "Fail",
            "Cause": "ScriptPathMissing",
            "Error": "See state in $.FlowResult of the run output"
        },
        "CheckScriptPathInfo": {
            "Comment": "Determine the type of the script path",
            "Type": "Choice",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.ScriptPathInfo.details.code",
                            "IsPresent": true
                        },
                        {
                            "Variable": "$.ScriptPathInfo.details.code",
                            "StringEquals": "NotFound"
                        }
                    ],
                    "Next": "ScriptPathMissing"
                }
            ],
            "Default": "CheckIfScriptPathIsFile"
        },
        "CheckIfScriptPathIsFile": {
            "Comment": "Determine if the script path is a file",
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.ScriptPathInfo.details.type",
                    "StringEquals": "file",
                    "Next": "StartJobNameFromPath"
                }
            ],
            "Default": "ScriptPathNotAFile"
        },
        "ScriptPathNotAFile": {
            "Next": "ScriptPathNotAFileFail",
            "Type": "ExpressionEval",
            "Parameters": {
                "error.=": "'Script path ' + input.script.path + ' is not a file'"
            },
            "ResultPath": "$.FlowResult"
        },
        "ScriptPathNotAFileFail": {
            "Comment": "Report the error and end the flow",
            "Type": "Fail",
            "Cause": "ScriptPathNotAFile",
            "Error": "See state in $.FlowResult of the run output"
        },
        "StartJobNameFromPath": {
            "Comment": "Initialise variables for building hyphenated name from path",
            "Type": "ExpressionEval",
            "Next": "ExtractPathComponent",
            "Parameters": {
                "current_path.=": "input.source.path",
                "result_name.=": "''",
                "combined.=": "''"
            },
            "ResultPath": "$.path_parts"
        },
        "ExtractPathComponent": {
            "Comment": "Split current path into parent and child",
            "Type": "ExpressionEval",
            "Next": "CheckIfDone",
            "Parameters": {
                "parent.=": "pathsplit(path_parts.current_path)[0]",
                "child.=": "pathsplit(path_parts.current_path)[1]",
                "combined.=": "path_parts.get('combined', '')"
            },
            "ResultPath": "$.path_parts"
        },
        "CheckIfDone": {
            "Comment": "Check if reached root / or empty path in parent, meaning child is the final component to add (AppendFinalComponent). Otherwise, there are more parts to extract from parent, so append child and continue. Note an empty child arises in the first iteration when the source path has a trailing slash. This case is handled by simply discarding that part and continuing with the parent.",
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.path_parts.parent",
                    "StringEquals": "",
                    "Next": "AppendFinalComponent"
                },
                {
                    "Variable": "$.path_parts.parent",
                    "StringEquals": "/",
                    "Next": "AppendFinalComponent"
                },
                {
                    "Variable": "$.path_parts.child",
                    "StringEquals": "",
                    "Next": "ContinueWithParent"
                }
            ],
            "Default": "AppendComponent"
        },
        "ContinueWithParent": {
            "Comment": "Handle empty component (from trailing slash) by continuing with parent",
            "Type": "ExpressionEval",
            "Next": "ExtractPathComponent",
            "Parameters": {
                "current_path.=": "path_parts.parent",
                "combined.=": "path_parts.get('combined', '')"
            },
            "ResultPath": "$.path_parts"
        },
        "AppendComponent": {
            "Type": "ExpressionEval",
            "Next": "UpdatePathForNextIteration",
            "Parameters": {
                "combined.=": "path_parts.child + '-' + path_parts.combined if path_parts.combined else path_parts.child",
                "parent.=": "path_parts.parent",
                "child.=": "path_parts.child"
            },
            "ResultPath": "$.path_parts"
        },
        "UpdatePathForNextIteration": {
            "Comment": "Move to parent path for next iteration",
            "Type": "ExpressionEval",
            "Next": "ExtractPathComponent",
            "Parameters": {
                "current_path.=": "path_parts.parent",
                "combined.=": "path_parts.combined"
            },
            "ResultPath": "$.path_parts"
        },
        "AppendFinalComponent": {
            "Comment": "Add the final component",
            "Type": "ExpressionEval",
            "Next": "EvaluateDirLocations",
            "Parameters": {
                "combined.=": "path_parts.child + '-' + path_parts.combined if path_parts.combined else path_parts.child"
            },
            "ResultPath": "$.path_parts"
        },
        "EvaluateDirLocations": {
            "Comment": "Expressions for directories that need to be created on dest",
            "Type": "ExpressionEval",
            "Next": "ExtractScriptFilename",
            "Parameters": {
                "upload.=": "input.dest.path + 'UploadedFiles/' + path_parts.combined",
                "data.=": "input.dest.path + 'UploadedFiles/' + path_parts.combined + '/data/'",
                "scripts.=": "input.dest.path + 'UploadedFiles/' +  path_parts.combined + '/scripts/'",
                "sentinels.=": "input.dest.path + 'UploadedFiles/' +  path_parts.combined + '/sentinels'",
				"analysed.=": "input.dest.path + 'AnalysedFiles/' + path_parts.combined",
				"analysed_sentinels.=": "input.dest.path + 'AnalysedFiles/' + path_parts.combined + '/sentinels'",
				"failed.=": "input.dest.path + 'FailedJobs/' + path_parts.combined",
				"echo.=": "input.echo.path + path_parts.combined"
            },
            "ResultPath": "$.dir_locations"
        },
        "ExtractScriptFilename": {
            "Comment": "Extract script filename and build destination path",
            "Type": "ExpressionEval",
            "Next": "MakeJobDir",
            "Parameters": {
                "script_filename.=": "pathsplit(input.script.path)[1]",
                "script_dest_path.=": "dir_locations.scripts + pathsplit(input.script.path)[1]"
            },
            "ResultPath": "$.script_info"
        },
        "MakeJobDir": {
            "Comment": "Make top-level directory for new job",
            "Next": "MakeDataDir",
            "Type": "Action",
            "ActionUrl": "https://transfer.actions.globus.org/mkdir",
            "Parameters": {
                "endpoint_id.$": "$.input.dest.id",
                "path.$": "$.dir_locations.upload"
            },
            "ResultPath": "$.mkdir_result"
        },
        "MakeDataDir": {
            "Comment": "Make data subdirectory",
            "Next": "MakeScriptsDir",
            "Type": "Action",
            "ActionUrl": "https://transfer.actions.globus.org/mkdir",
            "Parameters": {
                "endpoint_id.$": "$.input.dest.id",
                "path.$": "$.dir_locations.data"
            },
            "ResultPath": "$.mkdir_result"
        },
        "MakeScriptsDir": {
            "Comment": "Make directory for submission script",
            "Next": "TransferScript",
            "Type": "Action",
            "ActionUrl": "https://transfer.actions.globus.org/mkdir",
            "Parameters": {
                "endpoint_id.$": "$.input.dest.id",
                "path.$": "$.dir_locations.scripts"
            },
            "ResultPath": "$.mkdir_result"
        },
        "TransferScript": {
            "Comment": "Transfer submission script to scripts subdirectory",
            "Next": "TransferData",
            "Type": "Action",
            "ActionUrl": "https://transfer.actions.globus.org/transfer",
            "WaitTime": 300,
            "Parameters": {
				"notify_on_succeeded": false,
                "DATA": [
                    {
                        "source_path.$": "$.input.script.path",
                        "destination_path.$": "$.script_info.script_dest_path"
                    }
                ],
                "source_endpoint.$": "$.input.script.id",
                "destination_endpoint.$": "$.input.dest.id"
            },
            "ResultPath": "$.transfer_script_result"
        },
        "TransferData": {
            "Comment": "Transfer data from source to data subdirectory",
            "Next": "MakeSentinels",
            "Type": "Action",
            "ActionUrl": "https://transfer.actions.globus.org/transfer",
            "WaitTime": 172800,
            "Parameters": {
				"notify_on_succeeded": false,
                "DATA": [
                    {
                        "source_path.$": "$.input.source.path",
                        "destination_path.$": "$.dir_locations.data",
                        "recursive": true
                    }
                ],
                "source_endpoint.$": "$.input.source.id",
                "destination_endpoint.$": "$.input.dest.id"
            },
            "ResultPath": "$.transfer_data_result"
        },
        "MakeSentinels": {
            "Comment": "Make Sentinels subdirectory to mark job as ready to submit",
            "Type": "Action",
            "ActionUrl": "https://transfer.actions.globus.org/mkdir",
            "Parameters": {
                "endpoint_id.$": "$.input.dest.id",
                "path.$": "$.dir_locations.sentinels"
            },
            "ResultPath": "$.mkdir_result",
            "Next": "Wait"
        },
        "Wait": {
          "Type": "Wait",
          "Seconds": 60,
          "Next": "CheckInAnalysedFiles"
        },
        "CheckInAnalysedFiles": {
          "Comment": "Check if the job directory is in the AnalysedFiles directory of the cron service",
          "Next": "IsItInAnalysedFiles",
          "Type": "Action",
          "Catch": [
            {
              "Next": "CheckInAnalysedFilesFail",
              "ResultPath": "$.CheckInAnalysedFilesErrorResult",
              "ErrorEquals": [
                "ActionUnableToRun",
                "ActionFailedException",
                "ActionTimeout"
              ]
            }
          ],
          "WaitTime": 300,
          "ActionUrl": "https://transfer.actions.globus.org/stat",
          "Parameters": {
            "endpoint_id.$": "$.input.dest.id",
            "path.$": "$.dir_locations.analysed"
          },
          "ResultPath": "$.CheckInAnalysedFilesResult"
        },
        "CheckInAnalysedFilesFail": {
          "Comment": "Report the error and end the flow execution",
          "Type": "Fail",
          "Cause": "CheckInAnalysedFilesFail",
          "Error": "See state in $.CheckInAnalysedFilesErrorResult of the run output"
        },
        "IsItInAnalysedFiles": {
          "Type": "Choice",
          "Choices": [
            {
              "And": [
                {
                  "Variable": "$.CheckInAnalysedFilesResult.details.code",
                  "IsPresent": true
                },
                {
                  "Variable": "$.CheckInAnalysedFilesResult.details.code",
                  "StringEquals": "NotFound"
                }
              ],
              "Next": "Wait"
            }
          ],
          "Default": "CheckInAnalysedFilesSentinels"
        },
        "CheckInAnalysedFilesSentinels": {
          "Comment": "Check if the 'sentinels' sub-directory has been deleted from the job directory which now in the AnalysedFiles directory of the cron service",
          "Next": "IsItInAnalysedFilesSentinels",
          "Type": "Action",
          "Catch": [
            {
              "Next": "CheckInAnalysedFilesSentinelsFail",
              "ResultPath": "$.CheckInAnalysedFilesSentinelsErrorResult",
              "ErrorEquals": [
                "ActionUnableToRun",
                "ActionFailedException",
                "ActionTimeout"
              ]
            }
          ],
          "WaitTime": 300,
          "ActionUrl": "https://transfer.actions.globus.org/stat",
          "Parameters": {
            "endpoint_id.$": "$.input.dest.id",
            "path.$": "$.dir_locations.analysed_sentinels"
          },
          "ResultPath": "$.CheckInAnalysedFilesSentinelsResult"
        },
        "CheckInAnalysedFilesSentinelsFail": {
          "Comment": "Report the error and end the flow execution",
          "Type": "Fail",
          "Cause": "CheckInAnalysedFilesSentinelsFail",
          "Error": "See state in $.CheckInAnalysedFilesSentinelsErrorResult of the run output"
        },
        "IsItInAnalysedFilesSentinels": {
          "Type": "Choice",
          "Choices": [
            {
              "And": [
                {
                  "Variable": "$.CheckInAnalysedFilesSentinelsResult.details.code",
                  "IsPresent": true
                },
                {
                  "Variable": "$.CheckInAnalysedFilesSentinelsResult.details.code",
                  "StringEquals": "NotFound"
                }
              ],
              "Next": "TransferFilesBack"
            }
          ],
          "Default": "Wait"
        },
        "TransferFilesBack": {
            "Comment": "Transfer job directory back to the source path with sync option enabled",
            "Next": "ShouldDeleteFromAnalysedFiles",
            "Type": "Action",
            "Catch": [
              {
                "Next": "TransferFilesBackFail",
                "ResultPath": "$.TransferFilesBackErrorResult",
                "ErrorEquals": [
                  "ActionUnableToRun",
                  "ActionFailedException",
                  "ActionTimeout"
                ]
              }
            ],
            "ActionUrl": "https://transfer.actions.globus.org/transfer",
            "Parameters": {
                "source_endpoint.$": "$.input.dest.id",
                "destination_endpoint.$": "$.input.echo.id",
                "preserve_timestamp": true,
                "sync_level": 2,
                "verify_checksum": true,
                "label.=": "'Transfer AnalysedFiles to ' + `$.input.echo.id` + ':' + `$.dir_locations.echo`",
				"filter_rules":
				[
						{
						    "DATA_TYPE": "filter_rule",
						    "method": "exclude",
						    "type": "dir",
						    "name": "data"
						},
						{
						    "DATA_TYPE": "filter_rule",
						    "method": "exclude",
						    "type": "dir",
						    "name": "frames"
						}
				 ],
                "DATA": [
                    {
                        "source_path.$": "$.dir_locations.analysed",
                        "destination_path.$": "$.dir_locations.echo",
                        "recursive": true
                    }
                ]
            },
            "ResultPath": "$.TransferFilesBackResult",
            "WaitTime": 172800
        },
       "TransferFilesBackFail": {
          "Comment": "Report the error and end the flow execution",
          "Type": "Fail",
          "Cause": "TransferFilesBackFail",
          "Error": "See state in $.TransferFilesBackErrorResult of the run output"
        },
        "ShouldDeleteFromAnalysedFiles": {
          "Type": "Choice",
          "Choices": [
            {
              "Variable": "$.input.delete",
              "BooleanEquals": false,
              "Next": "Finish"
            }
          ],
          "Default": "DeleteJobFromAnalysedFiles"
        },
        "DeleteJobFromAnalysedFiles": {
            "Comment": "Delete job directory from AnalysedFiles directory in the cron service",
            "Next": "Finish",
            "Type": "Action",
            "Catch": [
              {
                "Next": "DeleteJobFromAnalysedFilesFail",
                "ResultPath": "$.DeleteJobFromAnalysedFilesErrorResult",
                "ErrorEquals": [
                  "ActionUnableToRun",
                  "ActionFailedException",
                  "ActionTimeout"
                ]
              }
            ],
            "ActionUrl": "https://transfer.actions.globus.org/delete",
            "Parameters": {
			  "notify_on_succeeded": false,
              "endpoint.$": "$.input.dest.id",
              "recursive": true,
              "label": "Remove analysed files for job on HPC",
              "DATA": [
                {
                  "path.$": "$.dir_locations.analysed"
                }
              ]
            },
            "ResultPath": "$.DeleteJobFromAnalysedFilesResult",
            "WaitTime": 300
        },
        "DeleteJobFromAnalysedFilesFail": {
          "Comment": "Report the error and end the flow execution",
          "Type": "Fail",
          "Cause": "DeleteJobFromAnalysedFilesFail",
          "Error": "See state in $.DeleteJobFromAnalysedFilesErrorResult of the run output"
        },
        "Finish": {
            "Type": "Pass",
            "Parameters": {
